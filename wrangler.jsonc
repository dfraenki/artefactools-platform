{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "artefactools-platform",
  "main": "index.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": [],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/agents/*", "/api/*", "/mcp/*", "/vault/*", "/github-virtualizer/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "USER_SESSION", "class_name": "UserSessionDO" },
      { "name": "ARTEFACTOOL", "class_name": "ArtefactoolDO" },
      { "name": "VAULT", "class_name": "CredentialVaultDO" },
      { "name": "SMART_HARNESS", "class_name": "SmartHarnessDO" },
      { "name": "VISUAL_WEB_COPILOT", "class_name": "VisualWebCopilotDO" },
      { "name": "GITHUB_VIRTUALIZER", "class_name": "GitHubVirtualizerDO" }
    ]
  },
  "exports": {
    "UserSessionDO": { "type": "durable-object", "storage": "sqlite" },
    "ArtefactoolDO": { "type": "durable-object", "storage": "sqlite" },
    "CredentialVaultDO": { "type": "durable-object", "storage": "sqlite" },
    "SmartHarnessDO": { "type": "durable-object", "storage": "sqlite" },
    "VisualWebCopilotDO": { "type": "durable-object", "storage": "sqlite" },
    "GitHubVirtualizerDO": { "type": "durable-object", "storage": "sqlite" }
  },
  "ai": { "binding": "AI" }
}
